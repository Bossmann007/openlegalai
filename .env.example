VITE_API_URL=http://localhost:3000
VITE_BASE_URL=/

# DataJud API pública do CNJ. Copie a chave vigente em
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Nunca commite a chave. Sem ela a busca ao vivo falha com erro honesto.
DATAJUD_API_KEY=
DATAJUD_DEFAULT_TRIBUNAL=tjpr
DATAJUD_MODE=auto

